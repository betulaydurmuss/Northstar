{
  "name": "northstar",
  "private": true,
  "type": "module",
  "description": "Uptime monitoring for agencies that answer to many clients.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "api",
    "worker",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run build -w shared",
    "dev": "concurrently -n api,worker,web -c magenta,cyan,blue \"npm run dev -w api\" \"npm run dev -w worker\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "admin:create": "npm run admin:create -w api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.43.1": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "msgpackr-extract@3.0.4": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
