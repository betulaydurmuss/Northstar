// Tables and columns are snake_case in Postgres and camelCase in TypeScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  super_admin
}

enum MonitorType {
  http
  ping
  keyword
}

enum KeywordMode {
  present
  absent
}

// agency_admin runs the agency; client_viewer is a customer who sees only their client.
enum MembershipRole {
  agency_admin
  client_viewer
}

enum DomainSource {
  rdap
  manual
}

enum ExpiryKind {
  certificate
  domain
}

// What the dashboard shows. `pending` means the monitor has never been checked.
enum MonitorState {
  pending
  up
  down
  paused
  // Inside a planned maintenance window: checks run, nobody is alerted.
  maintenance
}

// The public wording of an incident, as on most status pages.
enum IncidentUpdateStatus {
  investigating
  identified
  monitoring
  resolved
}

enum ReportStatus {
  queued
  ready
  failed
}

enum CheckStatus {
  up
  down
}

enum ChannelType {
  email
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String
  passwordHash  String    @map("password_hash")
  role          Role      @default(user)
  // Encrypted with the server key; never sent to the browser.
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  // Start (epoch seconds) of the last time step a code was accepted for. A code is only
  // accepted for a later step, so an intercepted code cannot be replayed.
  totpLastEpoch Int?      @map("totp_last_epoch")
  // SHA-256 of each unused one-time backup code. A used code is removed from the list.
  backupCodes   String[]  @map("backup_code_hashes")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  // Set by a platform admin. A suspended account cannot sign in and its sessions end.
  suspendedAt   DateTime? @map("suspended_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  sessions             Session[]
  membership           Membership?
  passwordResets       PasswordResetToken[]
  monitors             Monitor[]
  notificationChannels NotificationChannel[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  // Only a hash is stored, so a database leak does not hand out live sessions.
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  // The token this one replaced. Seeing it again means a stolen token is being replayed.
  previousTokenHash String?   @unique @map("previous_token_hash")
  // True once the second factor was checked, or when the account has none.
  mfaVerified       Boolean   @default(false) @map("mfa_verified")
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// An agency. Every monitor, client and domain belongs to exactly one, and every query
// is filtered by it.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String   @default("starter")
  createdAt DateTime @default(now()) @map("created_at")

  planLimits  Plan         @relation(fields: [plan], references: [id])
  clients     Client[]
  memberships Membership[]
  monitors    Monitor[]
  domains     Domain[]

  @@map("organizations")
}

// One of the agency's customers: a group of monitors with its own brand for status pages
// and reports.
model Client {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  contactEmail   String?  @map("contact_email")
  brandColor     String   @default("#818CF8") @map("brand_color")
  // A file name under api/storage/logos, served from /api/files/logos/.
  logoPath       String?  @map("logo_path")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitors     Monitor[]
  memberships  Membership[]
  domains      Domain[]
  statusPage   StatusPage?
  maintenance  MaintenanceWindow[]
  reports      Report[]
  invites      Invite[]

  @@unique([organizationId, name])
  @@map("clients")
}

// Ties a user to their organization. A client_viewer is also tied to one client.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("memberships")
}

model Monitor {
  id                   String       @id @default(uuid()) @db.Uuid
  // Who created it, and who gets the alert emails.
  ownerId              String       @map("owner_id") @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  clientId             String?      @map("client_id") @db.Uuid
  name                 String
  type                 MonitorType  @default(http)
  target               String
  intervalSec          Int          @default(60) @map("interval_sec")
  timeoutMs            Int          @default(10000) @map("timeout_ms")
  retries              Int          @default(2)
  isActive             Boolean      @default(true) @map("is_active")
  state                MonitorState @default(pending)
  lastCheckedAt        DateTime?    @map("last_checked_at")
  // Keyword monitors only: the text to look for, and whether it must be there or not.
  keyword              String?      @map("keyword")
  keywordMode          KeywordMode? @map("keyword_mode")
  keywordCaseSensitive Boolean      @default(false) @map("keyword_case_sensitive")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  checks       CheckResult[]
  hourly       CheckHourly[]
  incidents    Incident[]
  certificate  Certificate?
  statusPages  StatusPageMonitor[]

  @@index([ownerId])
  @@index([organizationId, clientId])
  @@map("monitors")
}

model CheckResult {
  id          BigInt      @id @default(autoincrement())
  monitorId   String      @map("monitor_id") @db.Uuid
  status      CheckStatus
  responseMs  Int?        @map("response_ms")
  statusCode  Int?        @map("status_code")
  error       String?
  // Taken during planned maintenance; left out of uptime and SLA figures.
  maintenance Boolean     @default(false)
  checkedAt   DateTime    @default(now()) @map("checked_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Every chart and uptime figure reads one monitor over a time range.
  @@index([monitorId, checkedAt])
  @@map("check_results")
}

// Checks older than seven days, folded into one row per monitor per hour by the nightly
// rollup. Uptime stays exact (counts are summed); percentiles become approximate.
model CheckHourly {
  monitorId  String   @map("monitor_id") @db.Uuid
  hour       DateTime
  upCount    Int      @map("up_count")
  totalCount Int      @map("total_count")
  // Mean and 95th percentile of the response times measured in that hour, and how many.
  avgMs      Float?   @map("avg_ms")
  p95Ms      Float?   @map("p95_ms")
  msCount    Int      @default(0) @map("ms_count")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([monitorId, hour])
  @@map("check_results_hourly")
}

// The TLS certificate an https monitor last presented, refreshed at most once a day.
model Certificate {
  monitorId  String    @id @map("monitor_id") @db.Uuid
  issuer     String?
  subject    String?
  validFrom  DateTime? @map("valid_from")
  validTo    DateTime? @map("valid_to")
  // False when the chain did not verify; the reason is in error.
  authorized Boolean
  error      String?
  checkedAt  DateTime  @map("checked_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// A registrable domain behind one or more monitors, and when its registration runs out.
model Domain {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clientId       String?      @map("client_id") @db.Uuid
  domain         String
  expiresAt      DateTime?    @map("expires_at")
  // rdap when looked up automatically, manual when someone typed the date in.
  source         DomainSource @default(rdap)
  error          String?
  checkedAt      DateTime?    @map("checked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, domain])
  @@map("domains")
}

// One row per expiry warning sent, so each threshold is emailed once per expiry date.
// A renewed certificate has a new date and starts over.
model ExpiryNotice {
  id        BigInt     @id @default(autoincrement())
  kind      ExpiryKind
  subjectId String     @map("subject_id")
  expiresAt DateTime   @map("expires_at")
  threshold Int
  sentAt    DateTime   @default(now()) @map("sent_at")

  @@unique([kind, subjectId, expiresAt, threshold])
  @@map("expiry_notices")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  monitorId  String    @map("monitor_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  cause      String

  monitor Monitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  updates IncidentUpdate[]

  @@index([monitorId, startedAt])
  @@map("incidents")
}

model NotificationChannel {
  id        String      @id @default(uuid()) @db.Uuid
  ownerId   String      @map("owner_id") @db.Uuid
  type      ChannelType
  // Encrypted JSON: addresses and tokens are unreadable without the server key.
  config    String
  createdAt DateTime    @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("notification_channels")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  // A dotted verb such as user.suspend or plan.update.
  action    String
  target    String?
  ip        String?
  // What changed, for actions where the target alone does not say.
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

// A client's public status page. Its logo and colour come from the client.
model StatusPage {
  id               String    @id @default(uuid()) @db.Uuid
  clientId         String    @unique @map("client_id") @db.Uuid
  slug             String    @unique
  title            String
  isPublic         Boolean   @default(true) @map("is_public")
  // status.client.com, pointed at us with a CNAME.
  customDomain     String?   @unique @map("custom_domain")
  // Set once a TXT record proves the agency controls the domain; cleared when it changes.
  domainVerifiedAt DateTime? @map("domain_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  client   Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monitors StatusPageMonitor[]

  @@map("status_pages")
}

// Which monitors a status page shows, in what order, under what public name.
model StatusPageMonitor {
  statusPageId String  @map("status_page_id") @db.Uuid
  monitorId    String  @map("monitor_id") @db.Uuid
  position     Int
  displayName  String? @map("display_name")
  groupName    String? @map("group_name")

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor    Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([statusPageId, monitorId])
  @@map("status_page_monitors")
}

model MaintenanceWindow {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startsAt])
  @@map("maintenance_windows")
}

// What the agency tells the public while an incident runs.
model IncidentUpdate {
  id         String               @id @default(uuid()) @db.Uuid
  incidentId String               @map("incident_id") @db.Uuid
  status     IncidentUpdateStatus
  message    String
  createdAt  DateTime             @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

// A monthly SLA report. The PDF is rendered by the worker and stored under api/storage.
model Report {
  id        String       @id @default(uuid()) @db.Uuid
  clientId  String       @map("client_id") @db.Uuid
  // YYYY-MM
  period    String
  status    ReportStatus @default(queued)
  filePath  String?      @map("file_path")
  error     String?
  createdAt DateTime     @default(now()) @map("created_at")
  sentAt    DateTime?    @map("sent_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
  @@map("reports")
}

// A one-time link that turns an email address into a client_viewer. Valid 72 hours.
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  email       String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("invites")
}

// What an agency on each plan may have. Platform admins edit these in the admin panel.
model Plan {
  id          String @id
  name        String
  maxMonitors Int    @map("max_monitors")
  maxClients  Int    @map("max_clients")

  organizations Organization[]

  @@map("plans")
}
