# Copy to .env and adjust. Every value here is safe for local development only.

DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar
REDIS_URL=redis://localhost:6379

# The api listens here; the web dev server proxies /api to it.
API_PORT=4000
# The only origin allowed by CORS and used in links inside emails.
WEB_ORIGIN=http://localhost:5173

# Mailpit in docker-compose catches everything sent to this SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Northstar <alerts@northstar.local>"

# Password for the demo account created by `npm run db:seed`.
SEED_DEMO_PASSWORD=change-me-before-seeding

# Signs access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Encrypts two-factor secrets at rest. 32 bytes in base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Number of reverse proxies in front of the api (0 locally, usually 1 in production).
TRUST_PROXY=0

# Development only. Lets monitors point at servers on this machine or private network,
# for example to watch a local test server go down. Never enable it in production:
# it turns off the guard that stops monitors from probing internal services.
ALLOW_PRIVATE_TARGETS=false

# How many checks one worker process runs at the same time.
CHECK_CONCURRENCY=20

# Where client logos and report PDFs are kept. Defaults to api/storage; the api and
# the worker must point at the same folder.
# STORAGE_DIR=/var/lib/northstar

# Chrome or Chromium used by the worker to render PDF reports. Found automatically in
# the usual install locations; set it if yours lives elsewhere.
# CHROME_PATH=/usr/bin/chromium

# Read by the web build: host names that serve the dashboard. Any other host is treated
# as a client's custom status page domain.
VITE_APP_HOSTS=localhost,127.0.0.1
