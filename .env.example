# Copy to .env and adjust. Every value here is safe for local development only.

DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar
REDIS_URL=redis://localhost:6379

# The api listens here; the web dev server proxies /api to it.
API_PORT=4000
# The only origin allowed by CORS and used in links inside emails.
WEB_ORIGIN=http://localhost:5173

# Mailpit in docker-compose catches everything sent to this SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Northstar <alerts@northstar.local>"

# Password for the demo account created by `npm run db:seed`.
SEED_DEMO_PASSWORD=change-me-before-seeding
